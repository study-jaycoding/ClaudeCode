# Project Viewer 설정 — 파일명을 .env 로 복사해서 수정.
# 모든 항목 optional. 비워두면 디폴트 사용.

# ── 데이터 경로 ──────────────────────────────────────────────────
# 프로젝트 폴더와 favorites.json 의 부모 디렉토리.
# 팀 공유 시 NAS 마운트 경로로: 예) Z:/team-data  또는  //nas/share/team-data
CCDATA_DIR=D:/ClaudeCode-data

# 따로 override 하고 싶을 때 (보통은 안 씀)
# CCDATA_PROJECTS_DIR=Z:/team-data/projects
# CCDATA_FAVORITES_FILE=Z:/team-data/favorites.json

# ── 서버 바인딩 ──────────────────────────────────────────────────
PV_PORT=8766

# 기본: 로컬만 (안전, 본인 PC 에서만 접속). 다른 PC 에서 접속 못함.
PV_BIND=127.0.0.1

# 하이브리드 시나리오 — 1대를 팀 PV 서버로 운영하고 50명이 LAN 으로 접속:
#   1) PV_BIND=0.0.0.0 으로 변경
#   2) 아래 EXTRA_* 에 서버 IP / 호스트네임 / 도메인 추가
#   3) "원본 위치 열기" 기능은 자동으로 비활성화 (보안)
# PV_BIND=0.0.0.0
# PV_EXTRA_ORIGINS=http://192.168.1.10:8766,http://pv.company.local:8766
# PV_EXTRA_HOSTS=192.168.1.10:8766,pv.company.local:8766

# ── 업로드 ────────────────────────────────────────────────────────
PV_MAX_UPLOAD_MB=500
