# Higgsfield Spotlight 설정 — 파일명을 .env 로 복사해서 수정.
# Project Viewer 와 같은 CCDATA_DIR 을 보면 favorites/프로젝트가 자동 공유됨.

# ── 데이터 경로 (PV 와 동일하게 설정) ────────────────────────────
CCDATA_DIR=D:/ClaudeCode-data
# CCDATA_PROJECTS_DIR=Z:/team-data/projects
# CCDATA_FAVORITES_FILE=Z:/team-data/favorites.json

# ── 서버 ──────────────────────────────────────────────────────────
SPOTLIGHT_PORT=8767
SPOTLIGHT_BIND=127.0.0.1
# LAN 노출 시: SPOTLIGHT_BIND=0.0.0.0 + 아래에 LAN IP 추가
# SPOTLIGHT_EXTRA_ORIGINS=http://192.168.1.10:8767
# SPOTLIGHT_EXTRA_HOSTS=192.168.1.10:8767

# ── 업로드 ────────────────────────────────────────────────────────
SPOTLIGHT_MAX_UPLOAD_MB=20
